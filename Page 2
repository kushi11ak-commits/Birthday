<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width,
               initial-scale=1.0,
               viewport-fit=cover">

<title>A Little Surprise 🧸❤️</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  width: 100%;
  min-height: 100%;
}

body {
  min-height: 100svh;
  overflow: hidden;
  font-family: Arial, sans-serif;

  background:
    radial-gradient(circle at top,
      #fff8fb 0%,
      #ffe8f1 45%,
      #ffd8e7 100%);

  display: flex;
  justify-content: center;
  align-items: center;

  position: relative;
}

/* Floating hearts */

.heart {
  position: absolute;
  font-size: clamp(20px, 6vw, 38px);
  opacity: 0;
  pointer-events: none;
  animation: floatHeart linear infinite;
}

.h1 {
  left: 8%;
  bottom: -50px;
  animation-duration: 7s;
}

.h2 {
  left: 25%;
  bottom: -50px;
  animation-duration: 9s;
  animation-delay: 2s;
}

.h3 {
  right: 23%;
  bottom: -50px;
  animation-duration: 8s;
  animation-delay: 1s;
}

.h4 {
  right: 7%;
  bottom: -50px;
  animation-duration: 10s;
  animation-delay: 3s;
}

/* Main container */

.container {
  width: 100%;
  min-height: 100svh;

  display: flex;
  flex-direction: column;

  justify-content: center;
  align-items: center;

  text-align: center;

  padding:
    25px
    20px
    max(25px, env(safe-area-inset-bottom));

  position: relative;
  z-index: 5;
}

/* Heading */

.title {
  font-size: clamp(30px, 8vw, 58px);
  color: #e91e63;
  font-weight: 700;

  margin-bottom: 8px;

  text-shadow:
    0 4px 12px rgba(233, 30, 99, .18);

  animation: titleFloat 2.5s ease-in-out infinite;
}

.subtitle {
  font-size: clamp(15px, 4.5vw, 22px);
  color: #8b5369;
  margin-bottom: 18px;
}

/* Teddy area */

.teddy-area {
  width: min(90vw, 420px);
  height: min(65vw, 390px);

  min-height: 270px;

  display: flex;
  justify-content: center;
  align-items: center;

  position: relative;
}

/* Teddy */

.teddy {
  font-size: clamp(130px, 42vw, 230px);

  position: relative;
  z-index: 3;

  animation:
    teddyFloat 2.5s ease-in-out infinite,
    teddyAppear 1.5s ease-out forwards;

  filter:
    drop-shadow(0 15px 15px rgba(130, 70, 70, .18));
}

/* Love hearts around teddy */

.love {
  position: absolute;
  z-index: 4;

  font-size: clamp(25px, 7vw, 45px);

  animation: loveFloat 2s ease-in-out infinite;
}

.love1 {
  top: 10%;
  left: 10%;
}

.love2 {
  top: 20%;
  right: 10%;
  animation-delay: .4s;
}

.love3 {
  bottom: 15%;
  left: 14%;
  animation-delay: .8s;
}

.love4 {
  bottom: 10%;
  right: 14%;
  animation-delay: 1.2s;
}

/* Message card */

.message {
  width: min(90vw, 500px);

  background: rgba(255,255,255,.75);

  border-radius: 25px;

  padding: 18px 20px;

  box-shadow:
    0 12px 35px rgba(180, 80, 110, .15);

  backdrop-filter: blur(8px);

  margin-bottom: 20px;

  animation: messageAppear 1.2s ease-out .4s both;
}

.message p {
  color: #70485a;

  font-size: clamp(15px, 4.2vw, 19px);

  line-height: 1.5;
}

.message strong {
  color: #e91e63;
}

/* Button */

.continue-btn {
  border: none;
  outline: none;

  background: #e91e63;
  color: white;

  padding: 14px 30px;

  border-radius: 50px;

  font-size: 17px;
  font-weight: bold;

  cursor: pointer;

  box-shadow:
    0 8px 22px rgba(233, 30, 99, .3);

  transition:
    transform .2s ease,
    box-shadow .2s ease;

  -webkit-tap-highlight-color: transparent;

  animation: buttonAppear 1s ease-out .8s both;
}

.continue-btn:active {
  transform: scale(.94);
}

@media (hover:hover) {
  .continue-btn:hover {
    transform: translateY(-3px) scale(1.03);

    box-shadow:
      0 12px 28px rgba(233, 30, 99, .4);
  }
}

/* Teddy floating */

@keyframes teddyFloat {

  0%, 100% {
    transform: translateY(0) rotate(-2deg);
  }

  50% {
    transform: translateY(-12px) rotate(2deg);
  }
}

/* Teddy entrance */

@keyframes teddyAppear {

  0% {
    opacity: 0;
    transform: scale(.4);
  }

  70% {
    opacity: 1;
    transform: scale(1.08);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* Title */

@keyframes titleFloat {

  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-5px);
  }
}

/* Love animation */

@keyframes loveFloat {

  0%, 100% {
    transform: translateY(0) scale(.85);
    opacity: .7;
  }

  50% {
    transform: translateY(-12px) scale(1.15);
    opacity: 1;
  }
}

/* Message */

@keyframes messageAppear {

  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Button */

@keyframes buttonAppear {

  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Floating background hearts */

@keyframes floatHeart {

  0% {
    transform:
      translateY(0)
      rotate(0deg)
      scale(.7);

    opacity: 0;
  }

  15% {
    opacity: .7;
  }

  80% {
    opacity: .7;
  }

  100% {
    transform:
      translateY(-115svh)
      rotate(360deg)
      scale(1.1);

    opacity: 0;
  }
}

/* Small phones */

@media (max-height: 680px) {

  .container {
    padding-top: 12px;
  }

  .title {
    font-size: clamp(27px, 8vw, 42px);
  }

  .subtitle {
    margin-bottom: 5px;
  }

  .teddy-area {
    height: 42vh;
    min-height: 200px;
  }

  .teddy {
    font-size: clamp(110px, 34vw, 175px);
  }

  .message {
    padding: 12px 16px;
    margin-bottom: 12px;
  }

  .message p {
    font-size: 14px;
  }

  .continue-btn {
    padding: 11px 24px;
    font-size: 15px;
  }
}

/* Landscape phones */

@media (orientation: landscape) and (max-height: 600px) {

  .container {
    padding: 8px;
  }

  .title {
    font-size: 30px;
    margin-bottom: 2px;
  }

  .subtitle {
    font-size: 14px;
    margin-bottom: 2px;
  }

  .teddy-area {
    height: 45vh;
    min-height: 130px;
  }

  .teddy {
    font-size: 120px;
  }

  .message {
    padding: 8px 15px;
    margin-bottom: 7px;
  }

  .message p {
    font-size: 13px;
  }

  .continue-btn {
    padding: 9px 20px;
    font-size: 14px;
  }
}
</style>
</head>

<body>

<!-- Floating hearts -->

<div class="heart h1">💕</div>
<div class="heart h2">💗</div>
<div class="heart h3">💖</div>
<div class="heart h4">❤️</div>


<main class="container">

  <h1 class="title">
    A Little Surprise 🧸❤️
  </h1>

  <p class="subtitle">
    You found me... but there's more! ✨
  </p>


  <!-- Teddy -->

  <section class="teddy-area">

    <div class="love love1">💖</div>
    <div class="love love2">💕</div>
    <div class="love love3">💗</div>
    <div class="love love4">💞</div>

    <div class="teddy">
      🧸
    </div>

  </section>


  <!-- Message -->

  <section class="message">

    <p>
      Hey you! 💕
      <br><br>

      This little teddy has something
      special to tell you...
      <br>

      <strong>
        You deserve all the happiness,
        love and beautiful moments
        in the world. ❤️
      </strong>
    </p>

  </section>


  <!-- Continue -->

  <button
    class="continue-btn"
    onclick="goToPage3()">

    There's more... 💝

  </button>

</main>


<script>

function goToPage3() {

  window.location.href = "page3.html";

}

</script>

</body>
</html>
